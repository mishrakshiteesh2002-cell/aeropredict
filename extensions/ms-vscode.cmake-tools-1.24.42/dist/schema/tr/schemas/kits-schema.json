						"description": "Ortam değişkeninin değeri"
					}
				}
			},
			"cmakeSettings": {
				"type": "object",
				"patternProperties": {
					".*": {
						"oneOf": [
							{
								"type": "string",
								"description": "CMake Ayarının değeri. Noktalı virgüller aynen geçirilir ve CMake tarafından liste ayırıcıları olarak işlenir."
							},
							{
								"type": "boolean",
								"description": "CMake Ayarının boole değeri. -D<key>:BOOL=TRUE/FALSE olarak yayılır."
							},
							{
								"type": "number",
								"description": "CMake Ayarının sayısal değeri. -D<key>:STRING=<number> olarak yayılır. Not: JSON sayıları sondaki sıfırları (1.10 ≡ 1.1) veya çok büyük/küçük büyükleri koruyamaz; tam metin önemli olduğunda dize olarak tırnak işareti ekleyin."
							},
							{
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "CMake listesi oluşturmak için noktalı virgüllerle birleştirilmiş dize dizisi."
							}
						]
					}
				}
			},
			"preferredGenerator": {
				"type": "object",
