		"properties": {
			"name": {
				"type": "string",
				"description": "Bu setin adı"
			},
			"description": {
				"type": "string",
				"description": "Bu kitin açıklaması"
			},
			"vendor": {
				"type": "string",
				"description": "Bu setin satıcı adı"
			},
			"triple": {
				"type": "string",
				"description": "Bu setin hedefi üçlüsü"
			},
			"version": {
				"type": "string",
				"description": "Bu setin sürümü"
			},
			"versionRuntime": {
				"type": "string",
				"description": "Setin C çalışma zamanı sürümü"
			},
